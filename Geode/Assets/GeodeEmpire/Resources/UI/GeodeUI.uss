/* Geode Empire UI — premium workshop instrument + mineral specimen card + restrained industrial chrome.
   Base sizes are for 1920x1080; PanelSettings scales with screen size (match 0.5).
   Type scale: title 34 / section 15 caps / card heading 22 / body 18 / value 28 / prompt 24 / caption 15. */
:root {
    -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Regular.ttf");
    color: rgb(240, 236, 228);
    font-size: 18px;
}
.bold { -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); }
.medium { -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---- surfaces ------------------------------------------------------------------------ */
.card {
    background-color: rgba(19, 16, 22, 0.94);
    border-width: 1px;
    border-color: rgba(255, 244, 220, 0.12);
    border-radius: 8px;
    padding: 12px 18px;
}
.accent { color: rgb(232, 190, 112); }
.muted { color: rgba(240, 236, 228, 0.6); }
.warn { color: rgb(232, 150, 130); }
.danger { color: rgb(232, 116, 96); }
.success { color: rgb(80, 214, 128); }
.caption { font-size: 15px; color: rgba(240, 236, 228, 0.6); letter-spacing: 1px; }
.section { font-size: 15px; color: rgba(232, 190, 112, 0.9); letter-spacing: 3px; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }

/* ---- HUD --------------------------------------------------------------------------- */
.crosshair { position: absolute; width: 5px; height: 5px; border-radius: 6px; background-color: rgba(255, 250, 240, 0.85); }
.crosshair-ring { position: absolute; width: 24px; height: 24px; border-radius: 12px; border-width: 2px; border-color: rgba(232, 190, 112, 0.95); background-color: rgba(0,0,0,0); }

.prompt { position: absolute; left: 50%; top: 57%; translate: -50% 0; font-size: 24px; -unity-text-align: middle-center; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); }
.prompt-hint { position: absolute; left: 50%; top: 86%; translate: -50% 0; font-size: 16px; color: rgba(240, 236, 228, 0.78); -unity-text-align: middle-center; padding: 6px 14px; background-color: rgba(18, 16, 14, 0.62); border-radius: 6px; border-width: 1px; border-color: rgba(255,244,220,0.08); }

.cash-card { position: absolute; left: 28px; top: 24px; flex-direction: row; align-items: center; padding: 10px 18px; }
.cash-label { font-size: 15px; color: rgba(240, 236, 228, 0.6); margin-right: 12px; letter-spacing: 3px; }
.cash-value { font-size: 30px; color: rgb(232, 190, 112); }
.cash-delta { font-size: 18px; margin-left: 12px; }

.tutorial { position: absolute; left: 50%; bottom: 52px; translate: -50% 0; max-width: 520px; -unity-text-align: middle-center; font-size: 13.5px; padding: 8px 15px; border-left-width: 3px; border-left-color: rgb(232, 190, 112); }

.notify-stack { position: absolute; right: 28px; top: 190px; align-items: flex-end; }
.notify { margin-bottom: 8px; font-size: 17px; max-width: 480px; padding: 10px 16px; }
.notify-success { border-left-width: 3px; border-left-color: rgb(80, 214, 128); }
.notify-warning { border-left-width: 3px; border-left-color: rgb(232, 116, 96); }
.notify-discovery { border-left-width: 3px; border-left-color: rgb(232, 190, 112); }

/* ---- bench overlay ---------------------------------------------------------------- */
.bench-panel { position: absolute; right: 28px; top: 240px; width: 420px; padding: 18px 20px 20px 20px; border-radius: 10px; background-color: rgba(19, 16, 22, 0.94); border-color: rgba(255, 244, 220, 0.11); }
.bench-title { font-size: 20px; letter-spacing: 4px; color: rgb(232, 190, 112); margin-bottom: 12px; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.meter-bg { height: 14px; background-color: rgba(255,255,255,0.09); border-radius: 4px; margin-top: 8px; margin-bottom: 8px; overflow: hidden; border-width: 0; }
.meter-fill { height: 14px; background-color: rgb(139, 92, 246); border-radius: 4px; }
.meter-fill-force { background-color: rgb(232, 168, 96); }
.bench-hint { font-size: 16px; color: rgba(238,233,226,0.72); margin-top: 12px; white-space: normal; }

/* ---- panels (tablet, appraisal, pause, letters) ------------------------------------- */
.panel-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(6, 5, 4, 0.66); align-items: center; justify-content: center; }
.panel { background-color: rgb(23, 20, 27); border-width: 1px; border-color: rgba(255,244,220,0.12); border-radius: 10px; padding: 26px 30px; }
.panel-title { font-size: 34px; margin-bottom: 2px; letter-spacing: 1px; }
.panel-subtitle { font-size: 16px; color: rgba(240,236,228,0.6); margin-bottom: 20px; letter-spacing: 1px; }
.tab-row { flex-direction: row; flex-shrink: 0; margin-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgba(255,244,220,0.1); padding-bottom: 0; }
.tab { padding: 9px 20px; margin-right: 8px; border-radius: 6px; background-color: rgba(255,255,255,0.04); font-size: 17px; letter-spacing: 1px; color: rgba(240,236,228,0.72); border-width: 1px; border-color: rgba(0,0,0,0); }
.tab:hover { background-color: rgba(255,255,255,0.09); color: rgb(240,236,228); }
.tab:focus { border-color: rgb(255, 214, 140); color: rgb(240,236,228); }
.tab-active { background-color: rgba(232,190,112,0.2); color: rgb(240,236,228); border-color: rgba(232,190,112,0.65); }

.btn { padding: 11px 22px; border-radius: 6px; background-color: rgba(232, 190, 112, 0.14); border-width: 1px; border-color: rgba(232,190,112,0.5); color: rgb(240,236,228); font-size: 18px; letter-spacing: 0.5px; -unity-text-align: middle-center; margin: 0; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.btn:hover { background-color: rgba(232, 190, 112, 0.3); border-color: rgba(232,190,112,0.8); }
.btn:focus { background-color: rgba(232, 190, 112, 0.34); border-color: rgb(255, 214, 140); border-width: 2px; padding: 10px 21px; }
.btn:active { background-color: rgba(232, 190, 112, 0.5); }
.btn:disabled { opacity: 0.38; }
.btn-primary { background-color: rgb(232, 190, 112); color: rgb(28,24,20); border-color: rgb(232, 190, 112); }
.btn-primary:hover { background-color: rgb(240, 196, 120); border-color: rgb(240, 196, 120); }
.btn-primary:focus { background-color: rgb(244, 204, 132); border-color: rgb(255, 236, 200); }
.btn-ghost { background-color: rgba(255,255,255,0.04); border-color: rgba(255,244,220,0.18); }
.btn-ghost:hover { background-color: rgba(255,255,255,0.09); }

.row { flex-direction: row; }
.grow { flex-grow: 1; }
.item-card { background-color: rgba(255,248,236,0.035); border-radius: 8px; padding: 16px 18px; margin-bottom: 10px; border-width: 1px; border-color: rgba(255,244,220,0.07); }
.item-card:hover { background-color: rgba(255,248,236,0.06); }
.item-card:focus { border-color: rgba(232,190,112,0.6); }
.item-title { font-size: 22px; }
.item-sub { font-size: 16px; color: rgba(240,236,228,0.62); margin-top: 2px; }
.item-desc { font-size: 16px; color: rgba(240,236,228,0.82); margin-top: 8px; white-space: normal; }
.price { font-size: 28px; color: rgb(232,190,112); }
.tag { font-size: 14px; padding: 4px 9px; border-radius: 2px; background-color: rgba(255,255,255,0.08); margin-right: 6px; letter-spacing: 2px; color: rgba(240,236,228,0.85); }
.tag-locked { background-color: rgba(232,116,96,0.18); color: rgb(232,150,130); }
.tag-owned { background-color: rgba(80,214,128,0.18); color: rgb(80,214,128); }

.stat-row { flex-direction: row; justify-content: space-between; padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgba(255,244,220,0.07); }
.stat-key { color: rgba(240,236,228,0.66); font-size: 17px; }
.stat-val { font-size: 17px; }

.appraisal-card { position: absolute; right: 28px; top: 240px; bottom: 96px; width: 470px; }
.appraisal-name { font-size: 26px; }
.appraisal-value { font-size: 34px; color: rgb(80, 214, 128); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); margin-top: 2px; }
.appraisal-record { font-size: 15px; color: rgb(80, 214, 128); margin-top: 8px; letter-spacing: 1px; white-space: normal; }
/* the valuation is set apart, the way the pack frames the number that matters */
.value-block { flex-shrink: 0; margin-top: 12px; padding: 12px 14px; border-radius: 8px; background-color: rgba(80, 214, 128, 0.09); border-width: 1px; border-color: rgba(80, 214, 128, 0.28); }
.appraisal-line { font-size: 17px; margin-top: 2px; }

.unity-scroll-view { flex-grow: 1; }
.unity-scroller { width: 10px; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: rgba(232,190,112,0.5); border-radius: 6px; border-width: 0; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(255,255,255,0.05); }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }

/* ---- settings controls ------------------------------------------------------------- */
.slider-row { flex-direction: row; align-items: center; margin-bottom: 10px; padding: 4px 6px; border-radius: 6px; }
.slider-row:hover { background-color: rgba(255,255,255,0.03); }
.slider-label { width: 230px; font-size: 17px; }
.unity-base-slider { flex-grow: 1; margin: 0 12px; }
.unity-base-slider__tracker { background-color: rgba(255,255,255,0.1); border-radius: 2px; border-width: 0; height: 6px; margin-top: -3px; }
.unity-base-slider__dragger { background-color: rgb(232,190,112); border-width: 0; border-radius: 8px; width: 16px; height: 16px; margin-top: -8px; }
.unity-base-slider:focus .unity-base-slider__dragger { background-color: rgb(255, 214, 140); border-width: 2px; border-color: rgb(255,236,200); }
.unity-toggle { margin: 0; }
.unity-toggle .unity-toggle__checkmark { background-color: rgba(255,255,255,0.08); border-color: rgba(255,244,220,0.3); border-width: 1px; border-radius: 6px; width: 20px; height: 20px; -unity-background-image-tint-color: rgb(28,24,20); }
.unity-toggle:checked .unity-toggle__checkmark { background-color: rgb(232,190,112); border-color: rgb(232,190,112); }
.unity-toggle:focus .unity-toggle__checkmark { border-color: rgb(255,214,140); border-width: 2px; }
.unity-base-dropdown__container-outer { background-color: rgb(26,24,21); border-color: rgba(232,190,112,0.5); }
.unity-base-field__label { min-width: 230px; font-size: 17px; color: rgb(240,236,228); }
.unity-base-popup-field__input { background-color: rgba(255,255,255,0.06); border-color: rgba(255,244,220,0.2); border-radius: 6px; color: rgb(240,236,228); padding: 6px 10px; }
.unity-base-popup-field:focus .unity-base-popup-field__input { border-color: rgb(255,214,140); }
.unity-base-popup-field__text { color: rgb(240,236,228); font-size: 17px; }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(232,190,112); }

/* ---- retail --------------------------------------------------------------------- */
.retail-chip { position: absolute; left: 28px; top: 372px; padding: 10px 16px; border-radius: 8px; border-left-width: 3px; border-left-color: rgba(240,236,228,0.35); }
.retail-chip-waiting { border-left-color: rgb(232, 190, 112); background-color: rgba(40, 32, 20, 0.9); }
.checkout-card {
    position: absolute; right: 28px; top: 240px; left: auto; translate: 0 0;
    width: 420px; align-items: stretch; padding: 18px 20px 20px 20px; border-radius: 10px;
    background-color: rgba(19, 16, 22, 0.94); border-color: rgba(255, 244, 220, 0.11);
}
.checkout-card-station { top: auto; bottom: 26px; right: 28px; width: 420px; padding: 12px 20px; }

/* ---- settings page ---- */
.settings { width: 100%; }
.settings-scroll { max-height: 430px; margin-top: 2px; }
.settings-scroll .unity-scroll-view__content-container { padding-right: 6px; }
.setting-text { width: 250px; flex-direction: column; flex-shrink: 0; }
.setting-text .slider-label { width: auto; }
.setting-desc { font-size: 14px; color: rgba(240, 236, 228, 0.5); margin-top: 1px; white-space: normal; }
.setting-value { width: 64px; -unity-text-align: middle-right; color: rgba(240, 236, 228, 0.7); font-size: 15px; }
.selector { flex-direction: row; align-items: center; flex-grow: 1; justify-content: flex-end; }
.selector-arrow { width: 34px; min-width: 34px; padding: 6px 0; margin: 0 4px; font-size: 20px; }
.selector-value { width: 190px; padding: 7px 10px; font-size: 16px; }
.settings-footer { flex-direction: row; justify-content: space-between; margin-top: 14px; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(255,244,220,0.1); }
.bindings-card { margin: 6px 6px 4px 6px; padding: 12px 14px; }
.binding-row { flex-direction: row; margin-top: 4px; }
.binding-action { width: 250px; color: rgba(240, 236, 228, 0.85); font-size: 15px; }
.binding-key { width: 150px; color: rgba(240, 236, 228, 0.6); font-size: 15px; }
.confirm-card { position: absolute; left: 60px; right: 60px; top: 45%; background-color: rgb(26, 23, 31); border-width: 1px; border-color: rgba(232,190,112,0.65); border-radius: 10px; padding: 20px 24px; }
.confirm-card .panel-subtitle { margin-bottom: 14px; }

.checkout-sold { border-color: rgb(80, 214, 128); background-color: rgba(60, 90, 55, 0.92); }

/* ============================================================================================
   Reference-match chrome — the persistent frame every screen in the target pack shares:
   a brand badge and standing goals top-left, the money/day/level block top-right, key hints
   along the bottom, and a specimen detail card down the right edge.
   ============================================================================================ */

.brand {
    position: absolute; left: 20px; top: 16px;
    flex-direction: row; align-items: center;
    padding: 6px 13px 6px 9px;
    background-color: rgba(19, 16, 22, 0.94);
    border-width: 1px; border-color: rgba(139, 92, 246, 0.5);
    border-radius: 9px;
}
.brand-gem { width: 15px; height: 15px; border-radius: 8px; margin-right: 9px; background-color: rgb(139, 92, 246); border-width: 2px; border-color: rgba(232, 190, 112, 0.85); }
.brand-name { font-size: 15px; letter-spacing: 2.5px; color: rgb(238, 233, 226); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }

.goals {
    position: absolute; left: 20px; top: 55px;
    width: 224px; padding: 8px 11px 8px 11px;
    background-color: rgba(19, 16, 22, 0.92);
    border-width: 1px; border-color: rgba(255, 244, 220, 0.10);
    border-radius: 9px;
}
.goals-title { font-size: 14px; letter-spacing: 0.5px; color: rgb(238, 233, 226); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); margin-bottom: 5px; }
.goal-row { flex-direction: row; align-items: center; margin-top: 3px; }
.goal-box { width: 11px; height: 11px; border-radius: 3px; border-width: 1px; border-color: rgba(255, 244, 220, 0.35); margin-right: 8px; }
.goal-box-done { background-color: rgb(232, 190, 112); border-color: rgb(232, 190, 112); }
.goal-star { color: rgb(232, 190, 112); font-size: 12px; margin-right: 7px; }
.goal-text { font-size: 13px; color: rgba(238, 233, 226, 0.86); flex-grow: 1; }
.goal-num { font-size: 11.5px; color: rgba(238, 233, 226, 0.55); }
.goal-head { color: rgb(238, 233, 226); }

.status {
    position: absolute; right: 20px; top: 16px;
    width: 200px; padding: 7px 11px 8px 11px;
    background-color: rgba(19, 16, 22, 0.94);
    border-width: 1px; border-color: rgba(255, 244, 220, 0.10);
    border-radius: 9px;
    align-items: flex-end;
}
.status-cash { font-size: 26px; color: rgb(80, 214, 128); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); }
.status-day { font-size: 12.5px; color: rgba(238, 233, 226, 0.88); margin-top: 0; }
.status-level { font-size: 11.5px; color: rgba(238, 233, 226, 0.66); margin-top: 3px; }
.xp-track { width: 100%; height: 15px; margin-top: 3px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.09); overflow: hidden; justify-content: center; }
.xp-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(139, 92, 246); border-radius: 4px; }
.xp-text { font-size: 11.5px; letter-spacing: 0.4px; color: rgba(255, 255, 255, 0.82); -unity-text-align: middle-center; width: 100%; }

/* key hint rail ------------------------------------------------------------------------- */
.keybar { position: absolute; left: 20px; bottom: 15px; flex-direction: row; align-items: center; }
.keybar-right { left: auto; right: 20px; }
.keyhint { flex-direction: row; align-items: center; margin-right: 15px; }
.keycap {
    font-size: 11.5px; letter-spacing: 0.5px; color: rgb(238, 233, 226);
    padding: 2px 7px; margin-right: 6px; min-width: 21px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.24);
    border-radius: 4px;
}
.keyhint-label { font-size: 12.5px; color: rgba(238, 233, 226, 0.78); }

/* world interaction chip ---------------------------------------------------------------- */
.interact-chip {
    position: absolute; left: 50%; top: 50%; translate: -50% 26px;
    flex-direction: row; align-items: center;
    padding: 4px 10px 4px 6px;
    background-color: rgba(19, 16, 22, 0.82);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.16);
    border-radius: 6px;
}
.crosshair-bar { position: absolute; background-color: rgba(255, 250, 240, 0.9); }

/* right-hand detail card ---------------------------------------------------------------- */
.detail {
    position: absolute; right: 28px; top: 240px; width: 424px;
    padding: 18px 20px 20px 20px;
    background-color: rgba(19, 16, 22, 0.94);
    border-width: 1px; border-color: rgba(255, 244, 220, 0.11);
    border-radius: 10px;
}
.detail-title { font-size: 25px; letter-spacing: 1px; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); white-space: normal; }
.detail .detail-title, .panel-detail .detail-title { flex-shrink: 1; }
.detail-sub { font-size: 18px; color: rgba(238, 233, 226, 0.6); margin-top: 1px; white-space: normal; }
.detail-note { font-size: 17px; color: rgba(238, 233, 226, 0.78); white-space: normal; margin-top: 10px; }
.kv { flex-direction: row; justify-content: space-between; align-items: center; padding: 4px 0; }
.kv-key { font-size: 17px; color: rgba(238, 233, 226, 0.6); }
.kv-val { font-size: 17px; color: rgb(238, 233, 226); }
.rule { height: 1px; background-color: rgba(255, 244, 220, 0.1); margin: 9px 0; }

/* rarity chips -------------------------------------------------------------------------- */
.rarity { font-size: 14px; letter-spacing: 2px; padding: 4px 11px; border-radius: 4px; -unity-text-align: middle-center; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.rarity-common { background-color: rgba(154, 160, 166, 0.22); color: rgb(196, 200, 204); }
.rarity-uncommon { background-color: rgba(111, 207, 151, 0.2); color: rgb(133, 219, 168); }
.rarity-rare { background-color: rgba(91, 155, 243, 0.22); color: rgb(130, 180, 250); }
.rarity-epic { background-color: rgba(168, 85, 247, 0.26); color: rgb(198, 145, 253); }
.rarity-legendary { background-color: rgba(232, 177, 92, 0.26); color: rgb(243, 200, 128); }

/* station panel: the right-hand instrument card the workstations share ------------------- */
.station {
    position: absolute; right: 28px; top: 240px; width: 420px;
    padding: 18px 20px 20px 20px;
    background-color: rgba(19, 16, 22, 0.94);
    border-width: 1px; border-color: rgba(255, 244, 220, 0.11);
    border-radius: 10px;
}
.station-title { font-size: 20px; letter-spacing: 4px; color: rgb(232, 190, 112); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); margin-bottom: 10px; }
.station-step { flex-direction: row; align-items: flex-start; margin-top: 10px; }
.station-num { width: 26px; height: 26px; border-radius: 13px; margin-right: 13px; font-size: 15px; -unity-text-align: middle-center; color: rgb(238, 233, 226); background-color: rgba(255, 255, 255, 0.1); border-width: 1px; border-color: rgba(255, 255, 255, 0.2); }
.station-num-active { background-color: rgba(139, 92, 246, 0.4); border-color: rgb(139, 92, 246); }
.station-steptitle { font-size: 19px; }
.station-stepnote { font-size: 16px; color: rgba(238, 233, 226, 0.58); white-space: normal; margin-top: 1px; }

/* action rows: a labelled key and what it does, stacked under a detail card -------------- */
.action-row { flex-direction: row; align-items: center; padding: 11px 15px; margin-top: 9px; border-radius: 7px; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 244, 220, 0.09); }
.action-row-primary { background-color: rgba(80, 214, 128, 0.16); border-color: rgba(80, 214, 128, 0.5); }
.action-row-accent { background-color: rgba(139, 92, 246, 0.2); border-color: rgba(139, 92, 246, 0.5); }
.action-label { font-size: 19px; flex-grow: 1; }
.action-note { font-size: 15px; color: rgba(238, 233, 226, 0.55); }

/* progress meter used by the stations ---------------------------------------------------- */
.meter-lg { height: 14px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.09); overflow: hidden; margin-top: 6px; }
.meter-lg-fill { height: 100%; background-color: rgb(139, 92, 246); border-radius: 4px; }

/* ---- full-screen management panel (tablet, collection, upgrades) ----------------------- */
.panel-head { flex-direction: row; align-items: center; flex-shrink: 0; padding-bottom: 16px; border-bottom-width: 1px; border-bottom-color: rgba(255, 244, 220, 0.1); }
.panel-brand { flex-direction: row; align-items: center; margin-right: 22px; }
.panel-brandname { font-size: 15px; letter-spacing: 3px; color: rgba(238, 233, 226, 0.72); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.page-title { font-size: 30px; letter-spacing: 3px; color: rgb(238, 233, 226); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); margin-bottom: 5px; }
.page-sub { font-size: 16px; color: rgba(238, 233, 226, 0.55); margin-top: 2px; }
.panel-body { flex-direction: row; flex-grow: 1; margin-top: 14px; }
.panel-list { flex-grow: 1; margin-right: 18px; }
.panel-detail { width: 400px; flex-shrink: 0; padding: 18px 20px; background-color: rgba(255, 250, 240, 0.035); border-width: 1px; border-color: rgba(255, 244, 220, 0.1); border-radius: 10px; }
/* nothing inside a card may shrink below its own text, or the lines lie on top of each other */
.panel-detail Label, .panel-detail .kv, .panel-detail .rule, .panel-detail .row,
.detail Label, .detail .kv, .detail .rule, .detail .row, .facts,
.station Label, .station .kv, .bench-panel Label { flex-shrink: 0; }
.card-scroll { flex-grow: 1; }
.facts { flex-shrink: 0; }
.panel-foot { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 44px; margin-top: 14px; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(255, 244, 220, 0.1); }

/* underline tabs, the pack's way of showing which page you are on */
.tab { background-color: rgba(0,0,0,0); border-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0,0,0,0); border-radius: 0; padding: 10px 4px; margin-right: 26px; font-size: 18px; letter-spacing: 1px; color: rgba(238, 233, 226, 0.55); }
.tab:hover { background-color: rgba(0,0,0,0); color: rgb(238, 233, 226); }
.tab:focus { background-color: rgba(0,0,0,0); border-bottom-color: rgba(232, 190, 112, 0.6); color: rgb(238, 233, 226); }
.tab-active { background-color: rgba(0,0,0,0); border-bottom-color: rgb(232, 190, 112); color: rgb(238, 233, 226); }

/* compact list rows with a rarity/family stripe, as the reference lists read */
.row-card { padding: 13px 16px; margin-bottom: 8px; border-radius: 8px; background-color: rgba(255, 250, 240, 0.04); border-width: 1px; border-color: rgba(255, 244, 220, 0.07); border-left-width: 3px; }
.row-card:hover { background-color: rgba(255, 250, 240, 0.075); }
.row-card:focus { background-color: rgba(139, 92, 246, 0.16); border-color: rgba(139, 92, 246, 0.65); }
.row-title { font-size: 19px; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.row-sub { font-size: 15px; color: rgba(238, 233, 226, 0.58); margin-top: 1px; }
.row-price { font-size: 22px; color: rgb(232, 190, 112); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); }
/* a specimen/family swatch standing in for the reference's thumbnail */
.swatch { width: 54px; height: 54px; border-radius: 9px; margin-right: 14px; flex-shrink: 0; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); align-items: center; justify-content: center; overflow: hidden; }
.swatch-core { width: 32px; height: 32px; border-radius: 16px; border-width: 2px; border-color: rgba(255, 255, 255, 0.12); }

/* ---- collection tiles ------------------------------------------------------------------ */
.tile { width: 300px; margin: 0 12px 12px 0; border-radius: 10px; overflow: hidden; background-color: rgba(255, 250, 240, 0.04); border-width: 1px; border-color: rgba(255, 244, 220, 0.08); }
.tile:hover { background-color: rgba(255, 250, 240, 0.075); border-color: rgba(232, 190, 112, 0.4); }
.tile-plate { height: 138px; -unity-background-scale-mode: scale-and-crop; }

.tile-body { padding: 12px 14px 14px 14px; }
.tile-body .row-sub { white-space: normal; }
.detail-plate { height: 166px; border-radius: 8px; overflow: hidden; -unity-background-scale-mode: scale-and-crop; }

/* ---- the discovery moment -------------------------------------------------------------- */
.discovery {
    position: absolute; left: 50%; top: 16%; translate: -50% 0; width: 430px;
    padding: 18px 20px 20px 20px;
    background-color: rgba(19, 16, 22, 0.96);
    border-width: 1px; border-color: rgba(232, 190, 112, 0.55);
    border-radius: 12px;
    align-items: stretch;
}
.discovery-kind { font-size: 17px; letter-spacing: 5px; color: rgb(232, 190, 112); -unity-text-align: middle-center; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); margin-bottom: 12px; }
.discovery-plate { height: 172px; border-radius: 8px; overflow: hidden; -unity-background-scale-mode: scale-and-crop; }
.discovery .appraisal-value { -unity-text-align: middle-right; margin-top: 8px; }
/* §12.1 the two card tiers are different sizes, not the same card at two durations: a genuinely new family is
   a short, modest card, and only extraordinary rarity gets the big one. */
.discovery-meaningful { width: 320px; padding: 12px 14px 14px 14px; top: 13%; border-color: rgba(232, 190, 112, 0.34); }
.discovery-meaningful .discovery-plate { height: 112px; }
.discovery-meaningful .discovery-kind { font-size: 14px; letter-spacing: 3px; margin-bottom: 8px; }
.discovery-exceptional { width: 470px; border-color: rgba(240, 206, 128, 0.85); border-width: 2px; }
.discovery-exceptional .discovery-plate { height: 196px; }
.discovery-detail { font-size: 14px; color: rgba(240, 236, 228, 0.62); -unity-text-align: middle-center; margin-top: 6px; white-space: normal; }

/* ---- pause ----------------------------------------------------------------------------- */
.pause-buttons { margin-top: 22px; }
.pause-buttons .btn { padding: 14px 22px; font-size: 19px; }
/* the primary action reads as the game's own accent, not a slab of tan */
.btn-primary { background-color: rgba(139, 92, 246, 0.3); color: rgb(240, 236, 228); border-color: rgb(139, 92, 246); }
.btn-primary:hover { background-color: rgba(139, 92, 246, 0.45); border-color: rgb(167, 130, 250); }
.btn-primary:focus { background-color: rgba(139, 92, 246, 0.55); border-color: rgb(196, 170, 255); }
.btn-primary:active { background-color: rgba(139, 92, 246, 0.7); }

/* ---- build mode (R11): layout editing that reads as part of the product ---------------- */
.build-overview { position: absolute; left: 28px; top: 96px; width: 300px; padding: 16px 18px; }
.build-budget { margin-top: 4px; }
.build-tip { font-size: 14px; color: rgba(240,236,228,0.55); white-space: normal; margin-top: 10px; }
.build-detail { position: absolute; right: 28px; top: 232px; width: 340px; padding: 18px 20px; }
.build-status { font-size: 16px; margin-top: 10px; white-space: normal; }
.build-bottom { position: absolute; left: 0; right: 0; bottom: 26px; align-items: center; }
.build-tabs { margin-bottom: 8px; }
.build-strip { padding: 8px; border-radius: 10px; background-color: rgba(19, 16, 22, 0.9); border-width: 1px; border-color: rgba(255,244,220,0.11); }
.build-cell { width: 128px; padding: 10px 10px 8px 10px; margin-right: 6px; border-radius: 8px; background-color: rgba(255,248,236,0.04); border-width: 1px; border-color: rgba(255,244,220,0.08); align-items: center; }
.build-cell-on { border-color: rgba(232,190,112,0.85); background-color: rgba(232,190,112,0.16); }
.build-cell-name { font-size: 15px; -unity-text-align: middle-center; white-space: normal; }
.build-rail { margin-top: 10px; }
.build-reason { position: absolute; left: 50%; top: 62%; translate: -50% 0; font-size: 19px; padding: 8px 16px; border-radius: 6px; -unity-text-align: middle-center; }
.build-reason-bad { color: rgb(255, 186, 170); background-color: rgba(70, 18, 14, 0.78); border-width: 1px; border-color: rgba(232,116,96,0.55); }

/* ---- inventory screen (R03) ------------------------------------------------------------ */
.inv-panel { position: absolute; left: 26px; top: 26px; bottom: 74px; width: 706px; padding: 18px 20px 12px 20px;
            background-color: rgba(14, 12, 17, 0.965); }
.inv-tabs { margin-top: 12px; margin-bottom: 4px; flex-shrink: 0; }
.inv-chips { flex-direction: row; flex-wrap: wrap; margin: 6px 0 8px 0; flex-shrink: 0; }
.inv-chip { font-size: 14px; letter-spacing: 1px; padding: 5px 11px; margin: 0 6px 6px 0; border-radius: 13px;
            background-color: rgba(255, 248, 236, 0.05); border-width: 1px; border-color: rgba(255,244,220,0.1);
            color: rgba(238,233,226,0.66); -unity-text-align: middle-center; }
.inv-chip:hover { background-color: rgba(255, 248, 236, 0.1); }
.inv-chip-on { background-color: rgba(232,190,112,0.18); border-color: rgba(232,190,112,0.8); color: rgb(244, 226, 194); }
.inv-filters { flex-direction: row; align-items: center; margin-bottom: 8px; flex-shrink: 0; }
.inv-filters .section { margin-right: 12px; }
.inv-search { width: 260px; margin: 0; }
.inv-search .unity-base-text-field__input { background-color: rgba(12, 10, 15, 0.7); border-width: 1px;
            border-color: rgba(255,244,220,0.13); border-radius: 6px; padding: 4px 8px; color: rgb(238,233,226); font-size: 15px; }
.inv-search-hint { font-size: 13px; margin-left: 10px; }
.inv-thead { flex-direction: row; align-items: center; padding: 0 6px 6px 6px; flex-shrink: 0;
            border-bottom-width: 1px; border-bottom-color: rgba(255,244,220,0.14); }
.inv-th { font-size: 12px; letter-spacing: 2px; color: rgba(238,233,226,0.45); }
.inv-th:hover { color: rgb(232,190,112); }
.inv-scroll { flex-grow: 1; flex-shrink: 1; margin-top: 2px; }
.inv-row { flex-direction: row; align-items: center; padding: 4px 6px; border-bottom-width: 1px;
            border-bottom-color: rgba(255,244,220,0.055); }
.inv-row:hover { background-color: rgba(255, 248, 236, 0.05); }
.inv-row-on { background-color: rgba(232,190,112,0.12); }
.inv-subrow { flex-direction: row; align-items: center; padding: 2px 6px 2px 44px; background-color: rgba(0,0,0,0.22); }
.inv-cell { font-size: 15px; color: rgb(232, 227, 220); }
.inv-plate { width: 44px; height: 26px; border-radius: 4px; margin-right: 8px; flex-shrink: 0;
            background-color: rgba(28,26,32,1); background-size: cover; border-width: 1px; border-color: rgba(255,255,255,0.08); }
.inv-col-item { flex-grow: 1; flex-shrink: 1; width: 190px; overflow: hidden; -unity-text-overflow-position: end; }
.inv-col-cat { width: 82px; flex-shrink: 0; font-size: 14px; }
.inv-col-qty { width: 42px; flex-shrink: 0; -unity-text-align: middle-right; padding-right: 10px; }
.inv-col-qty2 { width: 72px; flex-shrink: 0; -unity-text-align: middle-right; padding-right: 10px; font-size: 14px; }
.inv-col-qual { width: 88px; flex-shrink: 0; }
.inv-col-cond { width: 96px; flex-shrink: 0; }
.inv-col-val { width: 86px; flex-shrink: 0; -unity-text-align: middle-right; }
.inv-stars { flex-direction: row; align-items: center; }
.inv-star { font-size: 13px; color: rgba(238,233,226,0.22); margin-right: 1px; }
.inv-star-on { color: rgb(232,190,112); }
.inv-cond { flex-direction: row; align-items: center; }
.inv-cond .muted { font-size: 14px; }
.inv-dot { width: 7px; height: 7px; border-radius: 4px; margin-right: 7px; flex-shrink: 0; }
.inv-bullet { width: 14px; font-size: 13px; color: rgb(232,190,112); flex-shrink: 0; }
.inv-empty { font-size: 15px; padding: 16px 6px 4px 6px; white-space: normal; }
.inv-foot { flex-direction: row; align-items: center; padding-top: 8px; flex-shrink: 0;
            border-top-width: 1px; border-top-color: rgba(255,244,220,0.14); }
.inv-rail { position: relative; left: auto; bottom: auto; margin-top: 8px; flex-shrink: 0; }

/* ---- tutorial beacon (V6 §57: highlight the object the step is about) ------------------- */
.beacon { position: absolute; width: 0; height: 0; align-items: center; justify-content: center; }
.beacon-dot { position: absolute; width: 30px; height: 30px; left: -15px; top: -15px; border-radius: 15px;
              border-width: 2px; border-color: rgb(232, 190, 112); background-color: rgba(232, 190, 112, 0.14); }
/* off screen: the ring gives way to a big arrow that says which way to turn */
.beacon-off .beacon-dot { display: none; }
.beacon-chevron { position: absolute; width: 0; height: 0; left: -17px; top: -12px;
                  border-left-width: 17px; border-right-width: 17px; border-bottom-width: 24px;
                  border-left-color: rgba(0,0,0,0); border-right-color: rgba(0,0,0,0); border-bottom-color: rgb(240, 200, 120); }
.beacon-label { position: absolute; top: 20px; left: -44px; width: 88px; font-size: 14px; letter-spacing: 1px;
                color: rgb(244, 222, 178); -unity-text-align: middle-center; }
.beacon-off .beacon-label { top: 26px; }
.tutorial-done { border-left-color: rgb(92, 200, 128); }
.tutorial-tick { font-size: 12px; color: rgb(126, 216, 156); -unity-text-align: middle-center; }

/* ---- key rebinding (V6 §62) ------------------------------------------------------------ */
.binding-head { padding-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgba(255,244,220,0.12); margin-bottom: 4px; }
.binding-head .binding-action, .binding-col { font-size: 12px; letter-spacing: 2px; color: rgba(238,233,226,0.45); }
.binding-col { width: 150px; flex-shrink: 0; -unity-text-align: middle-center; }
.binding-btn { width: 150px; flex-shrink: 0; margin: 2px 0 2px 0; padding: 4px 6px; font-size: 15px;
               -unity-text-align: middle-center; background-color: rgba(255,248,236,0.05);
               border-width: 1px; border-color: rgba(255,244,220,0.14); border-radius: 5px; color: rgb(238,233,226); }
.binding-btn:hover { background-color: rgba(255,248,236,0.12); }
.binding-btn:focus { border-color: rgb(232,190,112); background-color: rgba(232,190,112,0.16); }
.binding-listening { border-color: rgb(232,190,112); background-color: rgba(232,190,112,0.24); color: rgb(248,232,200); }
.binding-unbound { color: rgb(232,140,120); border-color: rgba(232,116,96,0.5); }
.binding-fixed { width: 150px; flex-shrink: 0; -unity-text-align: middle-center; color: rgba(238,233,226,0.6); }
.goal-why { font-size: 12px; color: rgba(238,233,226,0.58); margin: 0 0 5px 0; max-width: 204px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

/* ---- upgrade cards (starter-rebuild §9.3: show the thing, not a coloured dot) ------------- */
.upg-card { padding: 12px 14px; }
/* the text column must give way to the price column, and wrap rather than run under it */
.upg-text { flex-grow: 1; flex-shrink: 1; overflow: hidden; margin-left: 14px; }
.upg-text > .row-sub { white-space: normal; }
.upg-side { flex-shrink: 0; width: 178px; align-items: flex-end; }
.upg-tile {
    background-color: rgba(255, 255, 255, 0.045);
    border-width: 1px; border-color: rgba(255, 244, 220, 0.12);
    border-radius: 8px;
    align-items: center; justify-content: center;
    flex-shrink: 0;
}
.upg-tile-letter { font-size: 30px; color: rgba(238, 233, 226, 0.45); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); }
.upg-lock { position: absolute; right: 6px; top: 4px; font-size: 13px; color: rgba(238, 233, 226, 0.5); }
.upg-owned-tick { position: absolute; right: 7px; top: 3px; font-size: 15px; color: rgb(92, 200, 128); }
.chip-row { flex-direction: row; flex-wrap: wrap; margin-top: 7px; }
.chip {
    font-size: 12px; padding: 2px 8px; margin: 2px 6px 0 0; border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 1px; border-color: rgba(255, 244, 220, 0.10);
    color: rgba(238, 233, 226, 0.78);
}
.chip-effect { color: rgb(126, 216, 156); border-color: rgba(126, 216, 156, 0.30); background-color: rgba(60, 150, 95, 0.12); }
.chip-world { color: rgb(226, 186, 118); border-color: rgba(226, 186, 118, 0.32); background-color: rgba(180, 140, 70, 0.13); }
.chip-place { color: rgb(178, 156, 240); border-color: rgba(178, 156, 240, 0.32); background-color: rgba(110, 84, 200, 0.14); }

/* ---- collection summary and undiscovered state (§9.4, §6.4) ------------------------------- */
.coll-summary {
    flex-direction: row; flex-wrap: wrap;
    margin: 2px 0 12px 0; padding: 10px 4px;
    border-bottom-width: 1px; border-bottom-color: rgba(255, 244, 220, 0.09);
}
.metric { margin-right: 34px; min-width: 96px; }
.metric-value { font-size: 22px; color: rgb(238, 233, 226); -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); margin-top: 2px; }
.tile-unknown {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    font-size: 40px; color: rgba(238, 233, 226, 0.22);
    -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf");
}
.crate-pip { position: absolute; left: 6px; bottom: 5px; width: 9px; height: 9px; border-radius: 5px; }
