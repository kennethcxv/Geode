/* Geode Empire UI: workshop labels + specimen cards. Base size tuned for 1080p, scaled by PanelSettings. */
:root {
    -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Regular.ttf");
    color: rgb(242, 238, 230);
    font-size: 20px;
}
.bold { -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); }
.medium { -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.card {
    background-color: rgba(18, 16, 14, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 6px;
    padding: 10px 16px;
}
.accent { color: rgb(226, 178, 96); }
.muted { color: rgba(242, 238, 230, 0.62); }
.danger { color: rgb(232, 110, 90); }
.success { color: rgb(150, 214, 140); }

.crosshair { position: absolute; width: 6px; height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.85); }
.crosshair-ring { position: absolute; width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: rgba(226, 178, 96, 0.9); background-color: rgba(0,0,0,0); }

.prompt { position: absolute; left: 50%; top: 56%; translate: -50% 0; font-size: 24px; -unity-text-align: middle-center; }
.prompt-hint { position: absolute; left: 50%; top: 84%; translate: -50% 0; font-size: 16px; color: rgba(242, 238, 230, 0.7); -unity-text-align: middle-center; padding: 4px 12px; background-color: rgba(18, 16, 14, 0.45); border-radius: 4px; }

.cash-card { position: absolute; left: 28px; top: 24px; flex-direction: row; align-items: center; }
.cash-label { font-size: 15px; color: rgba(242, 238, 230, 0.6); margin-right: 10px; letter-spacing: 2px; }
.cash-value { font-size: 30px; color: rgb(226, 178, 96); }
.cash-delta { font-size: 18px; margin-left: 12px; }

.tutorial { position: absolute; left: 50%; bottom: 40px; translate: -50% 0; max-width: 820px; -unity-text-align: middle-center; font-size: 20px; border-left-width: 3px; border-left-color: rgb(226, 178, 96); }

.notify-stack { position: absolute; right: 28px; top: 24px; align-items: flex-end; }
.notify { margin-bottom: 8px; font-size: 18px; max-width: 460px; }
.notify-success { border-left-width: 3px; border-left-color: rgb(150, 214, 140); }
.notify-warning { border-left-width: 3px; border-left-color: rgb(232, 110, 90); }
.notify-discovery { border-left-width: 3px; border-left-color: rgb(226, 178, 96); }

/* Bench overlay */
.bench-panel { position: absolute; right: 28px; bottom: 32px; width: 300px; }
.bench-title { font-size: 15px; letter-spacing: 2px; color: rgba(242,238,230,0.6); margin-bottom: 6px; }
.meter-bg { height: 10px; background-color: rgba(255,255,255,0.08); border-radius: 5px; margin-top: 6px; margin-bottom: 4px; overflow: hidden; }
.meter-fill { height: 10px; background-color: rgb(226, 178, 96); border-radius: 5px; }
.meter-fill-force { background-color: rgb(232, 150, 90); }
.bench-hint { font-size: 15px; color: rgba(242,238,230,0.7); margin-top: 6px; }

/* Generic panels (tablet, appraisal, pause) */
.panel-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 4, 6, 0.55); align-items: center; justify-content: center; }
.panel { background-color: rgb(24, 22, 20); border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 10px; padding: 24px 28px; }
.panel-title { font-size: 30px; margin-bottom: 4px; }
.panel-subtitle { font-size: 16px; color: rgba(242,238,230,0.6); margin-bottom: 18px; letter-spacing: 1px; }
.tab-row { flex-direction: row; margin-bottom: 16px; }
.tab { padding: 8px 18px; margin-right: 6px; border-radius: 6px; background-color: rgba(255,255,255,0.05); font-size: 17px; color: rgba(242,238,230,0.75); }
.tab:hover { background-color: rgba(255,255,255,0.1); }
.tab:focus { background-color: rgba(226,178,96,0.25); color: rgb(242,238,230); }
.tab-active { background-color: rgba(226,178,96,0.22); color: rgb(242,238,230); border-width: 1px; border-color: rgba(226,178,96,0.6); }

.btn { padding: 10px 20px; border-radius: 6px; background-color: rgba(226, 178, 96, 0.16); border-width: 1px; border-color: rgba(226,178,96,0.55); color: rgb(242,238,230); font-size: 18px; -unity-text-align: middle-center; margin: 0; }
.btn:hover { background-color: rgba(226, 178, 96, 0.3); }
.btn:focus { background-color: rgba(226, 178, 96, 0.34); border-color: rgb(255, 214, 140); }
.btn:disabled { opacity: 0.4; }
.btn-primary { background-color: rgba(226, 178, 96, 0.85); color: rgb(24,22,20); }
.btn-primary:hover { background-color: rgb(240, 196, 120); }
.btn-primary:focus { background-color: rgb(240, 196, 120); }
.btn-ghost { background-color: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.15); }

.row { flex-direction: row; }
.grow { flex-grow: 1; }
.item-card { background-color: rgba(255,255,255,0.04); border-radius: 8px; padding: 14px 16px; margin-bottom: 10px; border-width: 1px; border-color: rgba(255,255,255,0.06); }
.item-card:focus { border-color: rgba(226,178,96,0.6); }
.item-title { font-size: 20px; }
.item-sub { font-size: 15px; color: rgba(242,238,230,0.62); margin-top: 2px; }
.item-desc { font-size: 15px; color: rgba(242,238,230,0.78); margin-top: 8px; white-space: normal; }
.price { font-size: 22px; color: rgb(226,178,96); }
.tag { font-size: 13px; padding: 3px 8px; border-radius: 4px; background-color: rgba(255,255,255,0.08); margin-right: 6px; letter-spacing: 1px; }
.tag-locked { background-color: rgba(232,110,90,0.18); color: rgb(232,150,130); }
.tag-owned { background-color: rgba(150,214,140,0.18); color: rgb(150,214,140); }

.stat-row { flex-direction: row; justify-content: space-between; padding: 6px 0; border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,0.06); }
.stat-key { color: rgba(242,238,230,0.68); font-size: 16px; }
.stat-val { font-size: 16px; }

.appraisal-card { width: 520px; }
.appraisal-name { font-size: 30px; }
.appraisal-line { font-size: 17px; margin-top: 4px; }
.appraisal-value { font-size: 40px; color: rgb(226,178,96); margin-top: 14px; }
.appraisal-record { font-size: 16px; color: rgb(150,214,140); margin-top: 6px; }

.unity-scroll-view { flex-grow: 1; }
.unity-scroller { width: 10px; }

.slider-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.slider-label { width: 220px; font-size: 16px; }
.unity-base-slider { flex-grow: 1; margin: 0 10px; }
.unity-toggle { margin: 0; }
