/* Geode Empire UI — premium workshop instrument + mineral specimen card + restrained industrial chrome.
   Base sizes are for 1920x1080; PanelSettings scales with screen size (match 0.5).
   Type scale: title 34 / section 15 caps / card heading 22 / body 18 / value 28 / prompt 24 / caption 15. */
:root {
    -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Regular.ttf");
    color: rgb(240, 236, 228);
    font-size: 18px;
}
.bold { -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Bold.ttf"); }
.medium { -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---- surfaces ------------------------------------------------------------------------ */
.card {
    background-color: rgba(22, 20, 18, 0.86);
    border-width: 1px;
    border-color: rgba(255, 244, 220, 0.12);
    border-radius: 4px;
    padding: 12px 18px;
}
.accent { color: rgb(226, 178, 96); }
.muted { color: rgba(240, 236, 228, 0.6); }
.warn { color: rgb(232, 150, 130); }
.danger { color: rgb(232, 116, 96); }
.success { color: rgb(156, 212, 146); }
.caption { font-size: 15px; color: rgba(240, 236, 228, 0.6); letter-spacing: 1px; }
.section { font-size: 15px; color: rgba(226, 178, 96, 0.9); letter-spacing: 3px; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }

/* ---- HUD --------------------------------------------------------------------------- */
.crosshair { position: absolute; width: 5px; height: 5px; border-radius: 3px; background-color: rgba(255, 250, 240, 0.85); }
.crosshair-ring { position: absolute; width: 24px; height: 24px; border-radius: 12px; border-width: 2px; border-color: rgba(226, 178, 96, 0.95); background-color: rgba(0,0,0,0); }

.prompt { position: absolute; left: 50%; top: 57%; translate: -50% 0; font-size: 24px; -unity-text-align: middle-center; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); }
.prompt-hint { position: absolute; left: 50%; top: 86%; translate: -50% 0; font-size: 16px; color: rgba(240, 236, 228, 0.78); -unity-text-align: middle-center; padding: 6px 14px; background-color: rgba(18, 16, 14, 0.62); border-radius: 3px; border-width: 1px; border-color: rgba(255,244,220,0.08); }

.cash-card { position: absolute; left: 28px; top: 24px; flex-direction: row; align-items: center; padding: 10px 18px; }
.cash-label { font-size: 15px; color: rgba(240, 236, 228, 0.6); margin-right: 12px; letter-spacing: 3px; }
.cash-value { font-size: 30px; color: rgb(226, 178, 96); }
.cash-delta { font-size: 18px; margin-left: 12px; }

.tutorial { position: absolute; left: 50%; bottom: 28px; translate: -50% 0; max-width: 860px; -unity-text-align: middle-center; font-size: 20px; padding: 14px 24px; border-left-width: 3px; border-left-color: rgb(226, 178, 96); }

.notify-stack { position: absolute; right: 28px; top: 24px; align-items: flex-end; }
.notify { margin-bottom: 8px; font-size: 17px; max-width: 480px; padding: 10px 16px; }
.notify-success { border-left-width: 3px; border-left-color: rgb(156, 212, 146); }
.notify-warning { border-left-width: 3px; border-left-color: rgb(232, 116, 96); }
.notify-discovery { border-left-width: 3px; border-left-color: rgb(226, 178, 96); }

/* ---- bench overlay ---------------------------------------------------------------- */
.bench-panel { position: absolute; right: 28px; bottom: 32px; width: 340px; padding: 14px 18px; }
.bench-title { font-size: 15px; letter-spacing: 3px; color: rgba(226, 178, 96, 0.9); margin-bottom: 8px; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.meter-bg { height: 10px; background-color: rgba(255,255,255,0.08); border-radius: 2px; margin-top: 6px; margin-bottom: 6px; overflow: hidden; border-width: 1px; border-color: rgba(255,255,255,0.06); }
.meter-fill { height: 10px; background-color: rgb(226, 178, 96); border-radius: 2px; }
.meter-fill-force { background-color: rgb(232, 150, 90); }
.bench-hint { font-size: 15px; color: rgba(240,236,228,0.72); margin-top: 8px; }

/* ---- panels (tablet, appraisal, pause, letters) ------------------------------------- */
.panel-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(6, 5, 4, 0.66); align-items: center; justify-content: center; }
.panel { background-color: rgb(26, 24, 21); border-width: 1px; border-color: rgba(255,244,220,0.12); border-radius: 6px; padding: 26px 30px; }
.panel-title { font-size: 34px; margin-bottom: 2px; letter-spacing: 1px; }
.panel-subtitle { font-size: 16px; color: rgba(240,236,228,0.6); margin-bottom: 20px; letter-spacing: 1px; }
.tab-row { flex-direction: row; margin-bottom: 18px; border-bottom-width: 1px; border-bottom-color: rgba(255,244,220,0.1); padding-bottom: 10px; }
.tab { padding: 9px 20px; margin-right: 8px; border-radius: 3px; background-color: rgba(255,255,255,0.04); font-size: 17px; letter-spacing: 1px; color: rgba(240,236,228,0.72); border-width: 1px; border-color: rgba(0,0,0,0); }
.tab:hover { background-color: rgba(255,255,255,0.09); color: rgb(240,236,228); }
.tab:focus { border-color: rgb(255, 214, 140); color: rgb(240,236,228); }
.tab-active { background-color: rgba(226,178,96,0.2); color: rgb(240,236,228); border-color: rgba(226,178,96,0.65); }

.btn { padding: 11px 22px; border-radius: 3px; background-color: rgba(226, 178, 96, 0.14); border-width: 1px; border-color: rgba(226,178,96,0.5); color: rgb(240,236,228); font-size: 18px; letter-spacing: 0.5px; -unity-text-align: middle-center; margin: 0; -unity-font-definition: url("project:/Assets/GeodeEmpire/UI/Fonts/Roboto-Medium.ttf"); }
.btn:hover { background-color: rgba(226, 178, 96, 0.3); border-color: rgba(226,178,96,0.8); }
.btn:focus { background-color: rgba(226, 178, 96, 0.34); border-color: rgb(255, 214, 140); border-width: 2px; padding: 10px 21px; }
.btn:active { background-color: rgba(226, 178, 96, 0.5); }
.btn:disabled { opacity: 0.38; }
.btn-primary { background-color: rgb(226, 178, 96); color: rgb(28,24,20); border-color: rgb(226, 178, 96); }
.btn-primary:hover { background-color: rgb(240, 196, 120); border-color: rgb(240, 196, 120); }
.btn-primary:focus { background-color: rgb(244, 204, 132); border-color: rgb(255, 236, 200); }
.btn-ghost { background-color: rgba(255,255,255,0.04); border-color: rgba(255,244,220,0.18); }
.btn-ghost:hover { background-color: rgba(255,255,255,0.09); }

.row { flex-direction: row; }
.grow { flex-grow: 1; }
.item-card { background-color: rgba(255,248,236,0.035); border-radius: 4px; padding: 16px 18px; margin-bottom: 10px; border-width: 1px; border-color: rgba(255,244,220,0.07); }
.item-card:hover { background-color: rgba(255,248,236,0.06); }
.item-card:focus { border-color: rgba(226,178,96,0.6); }
.item-title { font-size: 22px; }
.item-sub { font-size: 16px; color: rgba(240,236,228,0.62); margin-top: 2px; }
.item-desc { font-size: 16px; color: rgba(240,236,228,0.82); margin-top: 8px; white-space: normal; }
.price { font-size: 28px; color: rgb(226,178,96); }
.tag { font-size: 14px; padding: 4px 9px; border-radius: 2px; background-color: rgba(255,255,255,0.08); margin-right: 6px; letter-spacing: 2px; color: rgba(240,236,228,0.85); }
.tag-locked { background-color: rgba(232,116,96,0.18); color: rgb(232,150,130); }
.tag-owned { background-color: rgba(156,212,146,0.18); color: rgb(156,212,146); }

.stat-row { flex-direction: row; justify-content: space-between; padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgba(255,244,220,0.07); }
.stat-key { color: rgba(240,236,228,0.66); font-size: 17px; }
.stat-val { font-size: 17px; }

.appraisal-card { width: 520px; }
.appraisal-name { font-size: 32px; }
.appraisal-line { font-size: 17px; margin-top: 2px; }
.appraisal-value { font-size: 40px; color: rgb(226,178,96); margin-top: 6px; }
.appraisal-record { font-size: 16px; color: rgb(156,212,146); margin-top: 6px; letter-spacing: 1px; }

.unity-scroll-view { flex-grow: 1; }
.unity-scroller { width: 10px; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: rgba(226,178,96,0.5); border-radius: 3px; border-width: 0; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(255,255,255,0.05); }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }

/* ---- settings controls ------------------------------------------------------------- */
.slider-row { flex-direction: row; align-items: center; margin-bottom: 10px; padding: 4px 6px; border-radius: 3px; }
.slider-row:hover { background-color: rgba(255,255,255,0.03); }
.slider-label { width: 230px; font-size: 17px; }
.unity-base-slider { flex-grow: 1; margin: 0 12px; }
.unity-base-slider__tracker { background-color: rgba(255,255,255,0.1); border-radius: 2px; border-width: 0; height: 6px; margin-top: -3px; }
.unity-base-slider__dragger { background-color: rgb(226,178,96); border-width: 0; border-radius: 8px; width: 16px; height: 16px; margin-top: -8px; }
.unity-base-slider:focus .unity-base-slider__dragger { background-color: rgb(255, 214, 140); border-width: 2px; border-color: rgb(255,236,200); }
.unity-toggle { margin: 0; }
.unity-toggle .unity-toggle__checkmark { background-color: rgba(255,255,255,0.08); border-color: rgba(255,244,220,0.3); border-width: 1px; border-radius: 3px; width: 20px; height: 20px; -unity-background-image-tint-color: rgb(28,24,20); }
.unity-toggle:checked .unity-toggle__checkmark { background-color: rgb(226,178,96); border-color: rgb(226,178,96); }
.unity-toggle:focus .unity-toggle__checkmark { border-color: rgb(255,214,140); border-width: 2px; }
.unity-base-dropdown__container-outer { background-color: rgb(26,24,21); border-color: rgba(226,178,96,0.5); }
.unity-base-field__label { min-width: 230px; font-size: 17px; color: rgb(240,236,228); }
.unity-base-popup-field__input { background-color: rgba(255,255,255,0.06); border-color: rgba(255,244,220,0.2); border-radius: 3px; color: rgb(240,236,228); padding: 6px 10px; }
.unity-base-popup-field:focus .unity-base-popup-field__input { border-color: rgb(255,214,140); }
.unity-base-popup-field__text { color: rgb(240,236,228); font-size: 17px; }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(226,178,96); }

/* ---- retail --------------------------------------------------------------------- */
.retail-chip { position: absolute; right: 28px; top: 96px; padding: 8px 14px; border-left-width: 3px; border-left-color: rgba(240,236,228,0.35); }
.retail-chip-waiting { border-left-color: rgb(226, 178, 96); background-color: rgba(40, 32, 20, 0.9); }
.checkout-card { position: absolute; left: 50%; top: 62%; translate: -50% 0; width: 520px; align-items: center; padding: 16px 24px; }

/* ---- settings page ---- */
.settings { width: 100%; }
.settings-scroll { max-height: 430px; margin-top: 2px; }
.settings-scroll .unity-scroll-view__content-container { padding-right: 6px; }
.setting-text { width: 250px; flex-direction: column; flex-shrink: 0; }
.setting-text .slider-label { width: auto; }
.setting-desc { font-size: 14px; color: rgba(240, 236, 228, 0.5); margin-top: 1px; white-space: normal; }
.setting-value { width: 64px; -unity-text-align: middle-right; color: rgba(240, 236, 228, 0.7); font-size: 15px; }
.selector { flex-direction: row; align-items: center; flex-grow: 1; justify-content: flex-end; }
.selector-arrow { width: 34px; min-width: 34px; padding: 6px 0; margin: 0 4px; font-size: 20px; }
.selector-value { width: 190px; padding: 7px 10px; font-size: 16px; }
.settings-footer { flex-direction: row; justify-content: space-between; margin-top: 14px; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(255,244,220,0.1); }
.bindings-card { margin: 6px 6px 4px 6px; padding: 12px 14px; }
.binding-row { flex-direction: row; margin-top: 4px; }
.binding-action { width: 250px; color: rgba(240, 236, 228, 0.85); font-size: 15px; }
.binding-key { width: 150px; color: rgba(240, 236, 228, 0.6); font-size: 15px; }
.confirm-card { position: absolute; left: 60px; right: 60px; top: 45%; background-color: rgb(30, 27, 24); border-width: 1px; border-color: rgba(226,178,96,0.65); border-radius: 6px; padding: 20px 24px; }
.confirm-card .panel-subtitle { margin-bottom: 14px; }

.checkout-sold { border-color: rgb(156, 212, 146); background-color: rgba(60, 90, 55, 0.92); }
